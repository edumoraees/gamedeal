# Copie este arquivo para .env antes de subir o ambiente:  cp .env.example .env
# O .env fica fora do Git (veja .gitignore). Troque os valores em produção.

# Credenciais dos bancos PostgreSQL (um banco por microservice)
DB_USER=gamedeal
DB_PASSWORD=gamedeal_dev_password

# Chave de assinatura dos tokens JWT (mínimo 32 caracteres). Compartilhada por auth-service e gateway.
JWT_SECRET=troque-esta-chave-por-uma-bem-longa-e-aleatoria-123456

# Senha do usuário admin do Grafana
GRAFANA_PASSWORD=admin
